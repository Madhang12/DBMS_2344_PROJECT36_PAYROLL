# Copy to .env and edit. Never commit .env. No real credentials belong in this file.
DB_BACKEND=sqlite            # sqlite (default, zero setup) or mysql
SQLITE_PATH=instance/payroll.db

# Used only when DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=payroll_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=payroll_db

# Signs the login session cookie. Leave empty to get a random key at every start (users are signed out on restart).
SECRET_KEY=

# Password given to the synthetic demo accounts (admin, hr, emp001..emp005) by scripts/init_db.py
DEMO_PASSWORD=Payroll@2026

# Forgot-password links: this demo has no e-mail server, so the link is shown on screen. Set SHOW_RESET_LINK=0 to hide it.
SHOW_RESET_LINK=1
RESET_TOKEN_MINUTES=15
